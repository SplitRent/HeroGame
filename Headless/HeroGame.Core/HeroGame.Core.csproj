<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity-owned sources in Game/Assets/_Project/Core (single source of truth). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>HeroGame.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GameAssets)/Core/**/*.cs" />
  </ItemGroup>
</Project>
