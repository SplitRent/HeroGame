          "Camera": "place:The Arden Ledger Newsroom",
          "Speaker": "narrator",
          "Text": "Mai writes for the Ledger now. Dee measures things at Tarrow State that nobody can explain.",
          "Seconds": 4
        },
        {
          "Camera": "player",
          "Speaker": "player",
          "Text": "Same street. Different city.",
          "Seconds": 3
        }
      ]
    }
  ],
